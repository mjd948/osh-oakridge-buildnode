{
  "name": "oscar-desktop",
  "version": "3.5.0",
  "description": "OSCAR Radiation Detection Desktop Application",
  "homepage": "https://github.com/Botts-Innovative-Research/osh-oakridge-buildnode",
  "author": "Botts Innovative Research, Inc. <support@botts-inc.com>",
  "license": "MPL-2.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:web": "npm --prefix ../web/oscar-viewer run build",
    "test:proxy": "node ../packaging/test/test-electron-proxy.js",
    "dist": "npm run build:web && electron-builder --win --x64",
    "dist:win": "npm run build:web && electron-builder --win --x64",
    "dist:linux": "npm run build:web && electron-builder --linux --x64",
    "dist:all": "npm run build:web && electron-builder --win --linux --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.botts.oscar",
    "productName": "OSCAR",
    "copyright": "Copyright © 2024 Botts Innovative Research, Inc.",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "proxy.js",
      "preload.js",
      "assets/**",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../web/oscar-viewer/web",
        "to": "web",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OSCAR",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] },
        { "target": "tar.gz", "arch": ["x64"] }
      ],
      "icon": "assets/icons",
      "category": "Science",
      "maintainer": "Botts Innovative Research, Inc. <support@botts-inc.com>",
      "synopsis": "OSCAR radiation portal monitoring client",
      "description": "Desktop client for OSCAR radiation portal monitoring. Connects to an OSCAR node over the network.",
      "desktop": {
        "StartupWMClass": "OSCAR"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    }
  }
}
